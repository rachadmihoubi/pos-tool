# =============================================================================
#  SECRETS - passwords and tokens
# =============================================================================
#
#  HOW TO USE THIS FILE
#  --------------------
#  1. Make a copy of it in this same folder and call the copy exactly:
#         .env
#     (a dot, then the word env, with no .txt on the end)
#  2. Fill in the lines you need.
#  3. Save it. Restart the tool.
#
#  The .env file is never shared, never uploaded, and is excluded from
#  version control. config.yaml holds settings; this file holds secrets.
#  Never put a password in config.yaml.
#
#  You only need to fill in the sections for the delivery channels you
#  actually switch on in config.yaml. The digest always saves to a file in
#  the digests folder, and that needs nothing here at all.
# =============================================================================


# -----------------------------------------------------------------------------
#  EMAIL
# -----------------------------------------------------------------------------
#  For Gmail you CANNOT use your normal Google password. Google blocks that.
#  You need an "app password", which is a 16-letter code just for this tool:
#
#     1. Go to  https://myaccount.google.com/security
#     2. Switch on "2-Step Verification" if it is not on already.
#        (App passwords do not exist until you do this.)
#     3. Go to  https://myaccount.google.com/apppasswords
#     4. Type a name, for example "Shop tool", and press Create.
#     5. Google shows 16 letters like:   abcd efgh ijkl mnop
#     6. Paste them below WITHOUT the spaces:  abcdefghijklmnop
#
#  If you ever think the code has been seen by someone else, go back to that
#  same page and delete it. The tool stops working and nothing else is at risk.
#
#  For a provider other than Gmail, use the password for that mailbox, and
#  set smtp_host and smtp_port in config.yaml to match your provider.

SMTP_PASSWORD=

# Only needed if the account you log in with is different from the address
# the mail is sent from. Most of the time, leave this blank.
SMTP_USERNAME=


# -----------------------------------------------------------------------------
#  TELEGRAM  (free, about five minutes to set up, no approval needed)
# -----------------------------------------------------------------------------
#  This is the easy one. Do this while any WhatsApp application is pending.
#
#  STEP 1 - create the bot and get the token
#     1. Open Telegram and search for the user   @BotFather
#     2. Send it:   /newbot
#     3. It asks for a name  ->  type anything, e.g.  Shop Report
#     4. It asks for a username ->  must end in "bot", e.g. quicktech_shop_bot
#     5. It replies with a token like:
#            123456789:AAEhBOweik6ad9r_QXqL1234567890abcdef
#        Paste that whole thing after TELEGRAM_BOT_TOKEN= below.
#
#  STEP 2 - get your chat id
#     1. In Telegram, find the bot you just made and send it any message
#        (just "hello" is fine). This is required - a bot cannot start a
#        conversation with you.
#     2. Open this address in a browser, putting your token in the middle:
#            https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#     3. Look for:   "chat":{"id":123456789,
#        That number is your chat id. Paste it below.
#
#  To send the digest to a group instead: add the bot to the group, send a
#  message in the group, and use the group's id from the same address. Group
#  ids start with a minus sign, e.g. -1001234567890 - keep the minus.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
#  WHATSAPP  (official Meta Cloud API only - costs money, needs approval)
# -----------------------------------------------------------------------------
#  Read the notes in config.yaml before starting. In short you need a Meta
#  Business account, a verified business, a phone number that can no longer
#  be used in the normal WhatsApp app, and a message template that Meta
#  approves before anything can be sent. Meta charges per conversation.
#
#  Get the access token from:
#     https://developers.facebook.com  ->  your app  ->  WhatsApp  ->  API Setup
#
#  The temporary token there lasts 24 hours and is only useful for testing.
#  For a tool that runs every day you need a permanent token, created from a
#  System User under Business Settings.
#
#  The phone_number_id goes in config.yaml, not here - it is not a secret.

WHATSAPP_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
#  CLOUDFLARE  (only needed if remote viewing is turned on in config.yaml)
# -----------------------------------------------------------------------------
#  This lets the tool push your dashboard to Cloudflare Pages so you can
#  check it from your phone. Create a token scoped to Pages only - not your
#  full Cloudflare account login - so a stolen copy of this file can only
#  ever touch your Pages dashboards, nothing else on the Cloudflare account.
#  Pushed directly over Cloudflare's REST API (poslib/remote.py) - no
#  wrangler, no Node.js needed on the machine.
#
#     1. Go to  https://dash.cloudflare.com/profile/api-tokens
#     2. Press "Create Token"
#     3. Press "Create Custom Token" (not one of the templates)
#     4. Under Permissions, choose:  Account  ->  Cloudflare Pages  ->  Edit
#     5. Under Account Resources, choose your account (there is no option
#        to limit this to a single Pages project - it will be able to
#        edit every Pages project on the account, just nothing else)
#     6. Press "Continue to summary", then "Create Token"
#     7. Copy the token shown (you only get to see it once) and paste it
#        below

CLOUDFLARE_API_TOKEN=

#  Your Cloudflare Account ID - not a secret in the sense of granting any
#  access on its own, but it lives here next to the token since the push
#  needs both together. Find it on the right-hand sidebar of any domain's
#  Overview page in the Cloudflare dashboard, or on
#  https://dash.cloudflare.com/ -> Workers & Pages -> Overview.

CLOUDFLARE_ACCOUNT_ID=
