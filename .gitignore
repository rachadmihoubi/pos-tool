# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
.cache
cache.db

# Virtual environment
.venv/
venv/

# OS
Thumbs.db
Desktop.ini

# IDE
.vscode/
*.code-workspace

# Claude Code: personal/machine-local overrides, never shared.
# .claude/settings.json (the SessionStart sync hook) IS committed on purpose -
# only settings.local.json is machine-specific and excluded here.
.claude/settings.local.json

# Secrets. Never commit this - it holds passwords and API tokens.
.env

# The local copy of your data, rebuilt automatically from the POS database.
cache.db
cache.db-journal
cache.building

# The POS database itself and any working copy of it. Never commit business data.
*.dblx
*.mdb
*.accdb
*.ldb
*.laccdb

# Generated output
digests/
logs/
*.xlsx

# Item photos extracted on-demand from the source database - not source, and
# not portable data to sync (rebuilds automatically per machine).
static/photo-cache/

# Owner-entered data (competitor prices, etc). Deliberately NOT gitignored
# in spirit - this is real, irreplaceable business data - but each machine
# keeps its own copy rather than syncing through git; back it up via the
# daily backup job instead.
data/

# Daily backups of the source database, cache and owner data. Never commit
# these - it's a full copy of live business data, same reason *.dblx above
# is excluded.
backups/

# The generated static export for the remote dashboard, and wrangler's own
# local state/cache. Both are regenerated/re-fetched automatically; never
# meant to be committed.
remote-site/
.wrangler/

# Node.js, only present if wrangler was ever installed as a local project
# dependency rather than globally.
node_modules/

# Local analysis output from the graphify skill - not project source.
graphify-out/

# PyInstaller build output (packaging/pos-tool.spec builds these). Both are
# regenerated from source on every build; only the spec file itself and
# requirements-build.txt are committed, never the built exe/bundle.
dist/
build/
